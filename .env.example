# Copy this to .env.local and fill in your Supabase project values.
# Run the app with:
#   flutter run --dart-define=SUPABASE_URL=https://xxx.supabase.co --dart-define=SUPABASE_ANON_KEY=eyJ...
#
# Or add to launch.json args:
#   "--dart-define=SUPABASE_URL=...", "--dart-define=SUPABASE_ANON_KEY=..."

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
REVENUECAT_KEY=appl_xxxxxxxxxxxxxxxx
# AdMob — also add GADApplicationIdentifier to ios/Runner/Info.plist
ADMOB_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
